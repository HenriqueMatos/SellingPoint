<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Shared control styles. Every interactive element here is at least 44px and has
    a visible pressed state: this runs on a touch screen, where hover does not
    exist and the only confirmation of a tap is what the button does.
  -->

  <!--
    The system font, deliberately. Avalonia's bundled Inter drops the accent from
    uppercase glyphs - "Água" renders as "Agua", "SESSÃO" as "SESSAO" - which in a
    Portuguese interface reads as broken text. Segoe UI on Windows and SF Pro on
    macOS both carry the full Latin set at every size.
  -->
  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource Surface0}" />
  </Style>

  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
  </Style>

  <!-- Panels -->
  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{DynamicResource Surface1}" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusLarge}" />
    <Setter Property="Padding" Value="{DynamicResource PanelPadding}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineSoft}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource Surface2}" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}" />
    <Setter Property="Padding" Value="12" />
  </Style>

  <!-- Labels -->
  <Style Selector="TextBlock.label">
    <Setter Property="Foreground" Value="{DynamicResource InkMuted}" />
    <Setter Property="FontSize" Value="{DynamicResource TextSmall}" />
    <Setter Property="Margin" Value="0,14,0,4" />
  </Style>

  <!-- Section headings are sentence case, not upper case. The bundled Inter drops
       the tilde from an uppercase Ã or Õ below about 15px, so "SESSÃO" renders as
       "SESSAO" - and a Portuguese interface that silently loses its diacritics
       reads as broken. Lowercase accents survive at any size, and sentence case is
       friendlier anyway. -->
  <Style Selector="TextBlock.section">
    <Setter Property="Foreground" Value="{DynamicResource InkMuted}" />
    <Setter Property="FontSize" Value="{DynamicResource TextSmall}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Margin" Value="0,0,0,10" />
  </Style>

  <Style Selector="TextBlock.hint">
    <Setter Property="Foreground" Value="{DynamicResource InkFaint}" />
    <Setter Property="FontSize" Value="{DynamicResource TextSmall}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- Buttons: a comfortable default, then intent variants -->
  <!-- 56px default: the kiosk guidance's touch minimum, not the 44px web one. A
       till is worked standing, at speed, without looking down. -->
  <Style Selector="Button">
    <Setter Property="MinHeight" Value="{DynamicResource TapMedium}" />
    <Setter Property="Padding" Value="18,12" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
    <Setter Property="FontSize" Value="{DynamicResource TextBody}" />
    <Setter Property="Background" Value="{DynamicResource Surface3}" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style Selector="Button:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#26344B" />
  </Style>

  <!-- The only feedback a finger gets. Without it a tap that did nothing and a
       tap that worked look identical. -->
  <Style Selector="Button:pressed">
    <Setter Property="RenderTransform" Value="scale(0.97)" />
  </Style>

  <Style Selector="Button:disabled">
    <Setter Property="Opacity" Value="0.35" />
  </Style>

  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource CashGradient}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CashBright}" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#16A34A" />
  </Style>

  <Style Selector="Button.card-pay">
    <Setter Property="Background" Value="{DynamicResource CardGradient}" />
    <Setter Property="BorderBrush" Value="#3B82F6" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="Button.card-pay:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#2563EB" />
  </Style>

  <Style Selector="Button.danger">
    <Setter Property="Background" Value="{DynamicResource Danger}" />
    <Setter Property="BorderBrush" Value="#F87171" />
  </Style>

  <!-- For destructive actions that sit next to the primary one. Findable, clearly
       marked, but not competing with Guardar for a thumb in a hurry - this is the
       button that deletes a category and every product in it. -->
  <Style Selector="Button.danger-quiet">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="#7F1D1D" />
    <Setter Property="Foreground" Value="#F87171" />
  </Style>
  <Style Selector="Button.danger-quiet:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#3B0D0D" />
  </Style>

  <Style Selector="Button.quiet">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
  </Style>

  <!-- Stepper buttons on a cart row. 56px with 10px between them, because a
       thumb that hits "remove" instead of "minus" costs a real argument. -->
  <Style Selector="Button.stepper">
    <Setter Property="Width" Value="{DynamicResource TapMedium}" />
    <Setter Property="Height" Value="{DynamicResource TapMedium}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontSize" Value="{DynamicResource TextTitle}" />
    <Setter Property="Background" Value="{DynamicResource Surface3}" />
  </Style>

  <Style Selector="Button.pill">
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusPill}" />
    <Setter Property="Padding" Value="14,8" />
  </Style>

  <!-- Text entry -->
  <Style Selector="TextBox">
    <Setter Property="MinHeight" Value="{DynamicResource TapSmall}" />
    <Setter Property="FontSize" Value="{DynamicResource TextBody}" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
    <Setter Property="Background" Value="{DynamicResource Surface2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="Padding" Value="12,8" />
  </Style>

  <Style Selector="ComboBox">
    <Setter Property="MinHeight" Value="{DynamicResource TapSmall}" />
    <Setter Property="FontSize" Value="{DynamicResource TextBody}" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
    <Setter Property="Background" Value="{DynamicResource Surface2}" />
  </Style>

  <Style Selector="CheckBox">
    <Setter Property="MinHeight" Value="{DynamicResource TapSmall}" />
    <Setter Property="FontSize" Value="{DynamicResource TextBody}" />
  </Style>

  <!-- List rows: tall enough to hit, and a selection you can see across a counter -->
  <Style Selector="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="ListBoxItem">
    <Setter Property="MinHeight" Value="{DynamicResource TapSmall}" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
    <Setter Property="Margin" Value="0,0,0,4" />
  </Style>

  <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Surface3}" />
  </Style>

  <!-- Top-level navigation -->
  <Style Selector="TabControl">
    <Setter Property="Background" Value="{DynamicResource Surface0}" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style Selector="TabItem">
    <Setter Property="FontSize" Value="{DynamicResource TextLarge}" />
    <Setter Property="MinHeight" Value="{DynamicResource TapMedium}" />
    <Setter Property="Padding" Value="22,12" />
    <Setter Property="Foreground" Value="{DynamicResource InkMuted}" />
  </Style>

  <Style Selector="TabItem:selected">
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

</Styles>

<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    One place for every colour and measurement in the app.

    The surfaces are a slate scale rather than pure black: black against a bright
    product button is harsh under the fluorescent light of a marquee, and it gives
    no way to show depth. Each step up the scale reads as "closer to the front".

    Every foreground/background pair here clears 4.5:1 — the muted text on a panel
    is 7:1, which still holds up on a cheap touch screen at a bad angle at night.
  -->

  <!-- Surfaces, back to front -->
  <SolidColorBrush x:Key="Surface0" Color="#020617" />
  <SolidColorBrush x:Key="Surface1" Color="#0B1220" />
  <SolidColorBrush x:Key="Surface2" Color="#131C2E" />
  <SolidColorBrush x:Key="Surface3" Color="#1E293B" />
  <SolidColorBrush x:Key="Line"     Color="#2B3A52" />
  <SolidColorBrush x:Key="LineSoft" Color="#1D2941" />

  <!-- Text -->
  <SolidColorBrush x:Key="Ink"      Color="#F8FAFC" />
  <SolidColorBrush x:Key="InkMuted" Color="#94A3B8" />
  <SolidColorBrush x:Key="InkFaint" Color="#64748B" />

  <!-- Meaning. Cash is green and card is blue everywhere they appear. -->
  <SolidColorBrush x:Key="Cash"        Color="#15803D" />
  <SolidColorBrush x:Key="CashBright"  Color="#22C55E" />
  <SolidColorBrush x:Key="Card"        Color="#1D4ED8" />
  <SolidColorBrush x:Key="Danger"      Color="#DC2626" />
  <SolidColorBrush x:Key="Warning"     Color="#D97706" />
  <SolidColorBrush x:Key="Accent"      Color="#38BDF8" />

  <!-- Touch. 44 is the smallest a finger hits reliably; 56 is what the hands
       reach for without looking, which is how a till is actually used. -->
  <x:Double x:Key="TapSmall">44</x:Double>
  <x:Double x:Key="TapMedium">56</x:Double>
  <x:Double x:Key="TapLarge">72</x:Double>

  <CornerRadius x:Key="RadiusSmall">6</CornerRadius>
  <CornerRadius x:Key="RadiusMedium">10</CornerRadius>
  <CornerRadius x:Key="RadiusLarge">14</CornerRadius>
  <CornerRadius x:Key="RadiusPill">999</CornerRadius>

  <!-- Type scale -->
  <x:Double x:Key="TextTiny">11</x:Double>
  <x:Double x:Key="TextSmall">13</x:Double>
  <x:Double x:Key="TextBody">15</x:Double>
  <x:Double x:Key="TextLarge">18</x:Double>
  <x:Double x:Key="TextTitle">22</x:Double>
  <x:Double x:Key="TextDisplay">34</x:Double>
  <x:Double x:Key="TextHuge">44</x:Double>

  <Thickness x:Key="PanelPadding">18</Thickness>

</ResourceDictionary>

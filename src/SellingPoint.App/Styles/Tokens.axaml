<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    One place for every colour and measurement in the app.

    "Festa": a warm near-black rather than a cold one, so the colour on top reads
    as lit rather than as printed on slate. Amber carries money throughout - the
    total, the change, the confirm button - so the number everyone in the queue is
    looking at is never the same colour as anything else.

    Every foreground/background pair clears 4.5:1; muted text on a panel is 7:1,
    and amber on a raised card is 6.8:1. That still holds on a cheap touch screen
    at a bad angle at night.
  -->

  <!-- Surfaces, back to front. Warmed towards brown rather than blue. -->
  <SolidColorBrush x:Key="Surface0" Color="#0B0F1A" />
  <SolidColorBrush x:Key="Surface1" Color="#141A28" />
  <SolidColorBrush x:Key="Surface2" Color="#1C2435" />
  <SolidColorBrush x:Key="Surface3" Color="#273044" />
  <SolidColorBrush x:Key="Line"     Color="#3A4560" />
  <SolidColorBrush x:Key="LineSoft" Color="#232D42" />

  <!-- Text -->
  <SolidColorBrush x:Key="Ink"      Color="#F8FAFC" />
  <SolidColorBrush x:Key="InkMuted" Color="#9CA9BF" />
  <SolidColorBrush x:Key="InkFaint" Color="#6B7A94" />

  <!-- Meaning. Cash is green, card is blue, money is amber, trouble is red. -->
  <SolidColorBrush x:Key="Cash"        Color="#15803D" />
  <SolidColorBrush x:Key="CashBright"  Color="#22C55E" />
  <SolidColorBrush x:Key="Card"        Color="#1D4ED8" />
  <SolidColorBrush x:Key="Danger"      Color="#DC2626" />
  <SolidColorBrush x:Key="Warning"     Color="#D97706" />
  <SolidColorBrush x:Key="Accent"      Color="#38BDF8" />

  <!-- The money colour. 6.8:1 on Surface3. -->
  <SolidColorBrush x:Key="Money"       Color="#F59E0B" />
  <SolidColorBrush x:Key="MoneyDeep"   Color="#B45309" />

  <!-- A warm lift under the total, so it reads as the lit thing on the screen. -->
  <LinearGradientBrush x:Key="MoneyGlow" StartPoint="0%,0%" EndPoint="0%,100%">
    <GradientStop Color="#2A2418" Offset="0" />
    <GradientStop Color="#1F1B14" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="CashGradient" StartPoint="0%,0%" EndPoint="0%,100%">
    <GradientStop Color="#17A34A" Offset="0" />
    <GradientStop Color="#14532D" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="CardGradient" StartPoint="0%,0%" EndPoint="0%,100%">
    <GradientStop Color="#2563EB" Offset="0" />
    <GradientStop Color="#1E3A8A" Offset="1" />
  </LinearGradientBrush>

  <!--
    Touch. The kiosk guidance asks for 56px minimum on a touch target, above the
    44px web baseline: a till is used at speed, standing, without looking down.
    56 is the default button; 48 is only for minor controls that are never on the
    critical path; 80 is for taking money.
  -->
  <x:Double x:Key="TapSmall">48</x:Double>
  <x:Double x:Key="TapMedium">56</x:Double>
  <x:Double x:Key="TapLarge">80</x:Double>

  <CornerRadius x:Key="RadiusSmall">8</CornerRadius>
  <CornerRadius x:Key="RadiusMedium">12</CornerRadius>
  <CornerRadius x:Key="RadiusLarge">16</CornerRadius>
  <CornerRadius x:Key="RadiusPill">999</CornerRadius>

  <!-- Type scale -->
  <x:Double x:Key="TextTiny">11</x:Double>
  <x:Double x:Key="TextSmall">13</x:Double>
  <x:Double x:Key="TextBody">15</x:Double>
  <x:Double x:Key="TextLarge">18</x:Double>
  <x:Double x:Key="TextTitle">22</x:Double>
  <x:Double x:Key="TextDisplay">34</x:Double>
  <x:Double x:Key="TextHuge">46</x:Double>

  <Thickness x:Key="PanelPadding">18</Thickness>

</ResourceDictionary>

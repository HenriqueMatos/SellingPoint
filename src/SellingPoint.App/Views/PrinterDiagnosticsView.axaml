<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SellingPoint.App.ViewModels"
             x:Class="SellingPoint.App.Views.PrinterDiagnosticsView"
             x:DataType="vm:PrinterDiagnosticsViewModel">

  <UserControl.Styles>
    <Style Selector="TextBlock.section">
      <Setter Property="Margin" Value="0,22,0,8" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer>
    <StackPanel>

      <!-- What is wrong, and what to do about it -->
      <StackPanel Orientation="Horizontal" Spacing="12">
        <Ellipse Width="18" Height="18" Fill="{Binding StatusBrush}" VerticalAlignment="Center" />
        <TextBlock Text="{Binding StatusText}" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" />
      </StackPanel>

      <TextBlock Text="{Binding AdviceText}" TextWrapping="Wrap" FontSize="15" Margin="0,10,0,0" />

      <TextBlock Text="{Binding ConnectionText}" FontSize="12" Opacity="0.6" Margin="0,10,0,0" />
      <TextBlock Text="{Binding PendingText}" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0" />
      <TextBlock Text="{Binding LastError}" FontSize="12" Opacity="0.6" TextWrapping="Wrap"
                 IsVisible="{Binding LastError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

      <!-- The buttons that fix it -->
      <WrapPanel Margin="0,18,0,0">
        <Button Content="Tentar agora" Classes="primary" MinWidth="160" Margin="0,0,8,8" Command="{Binding RetryNowCommand}" />
        <Button Content="Procurar impressora" MinWidth="190" Margin="0,0,8,8"
                Command="{Binding FindPrinterCommand}"
                IsEnabled="{Binding CanScanPorts}" />
        <Button Content="Verificar estado" MinWidth="160" Margin="0,0,8,8"
                Command="{Binding CheckNowCommand}" />
        <Button Content="Teste" MinWidth="100" Margin="0,0,8,8"
                Command="{Binding PrintTestCommand}" />
      </WrapPanel>

      <StackPanel Orientation="Horizontal" Spacing="24">
        <Button Content="{Binding PauseLabel}" Classes="quiet" Command="{Binding TogglePauseCommand}" />
        <!-- Every slip in the queue belongs to someone who has already paid, so
             this asks on the first tap. Kept well clear of the pause button:
             the two used to sit eight pixels apart wearing the same styling. -->
        <Button Content="{Binding DiscardLabel}" Classes="danger-quiet"
                Classes.armed="{Binding DiscardArmed}"
                Command="{Binding DiscardQueueCommand}" />
      </StackPanel>

      <Border Background="#33FFAA00" CornerRadius="6" Padding="10" Margin="0,12,0,0"
              IsVisible="{Binding IsPaused}">
        <TextBlock Text="A impressão está em pausa. Nada sai até retomar." TextWrapping="Wrap" />
      </Border>

      <!-- What is waiting -->
      <TextBlock Text="Talões em espera" Classes="section"
                 IsVisible="{Binding Queue.Count}" />
      <ItemsControl ItemsSource="{Binding Queue}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:QueuedJobViewModel">
            <Grid ColumnDefinitions="*,Auto" Margin="0,3">
              <TextBlock Grid.Column="0" Text="{Binding Title}" FontWeight="SemiBold" LineHeight="26" />
              <TextBlock Grid.Column="1" Text="{Binding Detail}" FontSize="11" Opacity="0.6" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- Where the printer actually is -->
      <TextBlock Text="Portas encontradas" Classes="section" IsVisible="{Binding Ports.Count}" />
      <TextBlock Text="{Binding ScanResultText}" TextWrapping="Wrap" FontSize="13" Margin="0,0,0,6"
                 IsVisible="{Binding ScanResultText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <ItemsControl ItemsSource="{Binding Ports}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:PortProbeViewModel">
            <Grid ColumnDefinitions="Auto,90,*" Margin="0,3">
              <Ellipse Grid.Column="0" Width="9" Height="9" Fill="{Binding Marker}"
                       VerticalAlignment="Center" Margin="0,0,8,0" />
              <TextBlock Grid.Column="1" Text="{Binding PortName}" FontWeight="SemiBold" />
              <TextBlock Grid.Column="2" Text="{Binding Message}" Opacity="0.7" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>

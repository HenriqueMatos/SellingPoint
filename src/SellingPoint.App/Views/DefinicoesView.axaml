<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SellingPoint.App.ViewModels"
             x:Class="SellingPoint.App.Views.DefinicoesView"
             x:DataType="vm:DefinicoesViewModel">

  <UserControl.Styles>
    <Style Selector="ComboBox">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <!-- Section headings here separate whole groups of settings, so they carry
         more weight than the small labels used inside a panel. -->
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="{DynamicResource TextBody}" />
      <Setter Property="Foreground" Value="{DynamicResource Accent}" />
      <Setter Property="Margin" Value="0,26,0,6" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="*,Auto">
    <ScrollViewer Grid.Row="0" Padding="24,18">
      <StackPanel MaxWidth="640" HorizontalAlignment="Left">

        <TextBlock Text="Impressora" Classes="section" Margin="0,0,0,4" />

        <TextBlock Text="Ligação" Classes="label" />
        <ComboBox ItemsSource="{Binding Transports}" SelectedItem="{Binding Transport}" />

        <TextBlock Text="Destino" Classes="label" />
        <Grid ColumnDefinitions="*,Auto">
          <TextBox Grid.Column="0" Text="{Binding Target}" FontSize="15" />
          <Button Grid.Column="1" Content="Procurar" Margin="8,0,0,0"
                  IsVisible="{Binding IsSerial}" Command="{Binding ScanPortsCommand}" />
        </Grid>
        <TextBlock Text="{Binding TargetHint}" FontSize="12" Opacity="0.6" TextWrapping="Wrap" Margin="0,4,0,0" />

        <!-- What the machine actually has. Tapping one fills the destination, so
             the exact name never has to be typed. -->
        <StackPanel IsVisible="{Binding ShowTargetList}" Margin="0,10,0,0">
          <TextBlock Text="{Binding TargetListHint}" Classes="hint" Margin="0,0,0,6" />
          <ListBox ItemsSource="{Binding AvailableTargets}" SelectedItem="{Binding SelectedTarget}">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="Margin" Value="0,0,8,8" />
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" FontSize="{DynamicResource TextBody}" LineHeight="26" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>

        <TextBlock Text="Largura do papel" Classes="label" />
        <ComboBox ItemsSource="{Binding PaperWidths}" SelectedItem="{Binding PaperWidth}" />

        <TextBlock Text="Tabela de caracteres" Classes="label" />
        <ComboBox ItemsSource="{Binding CodePages}" SelectedItem="{Binding CodePage}" />
        <CheckBox IsChecked="{Binding FoldAccents}" Margin="0,6,0,0"
                  Content="Retirar acentos antes de imprimir" />
        <TextBlock FontSize="12" Opacity="0.6" TextWrapping="Wrap"
                   Text="Só é preciso se a impressora não souber acentos. Faça o teste de impressão e veja a linha dos acentos." />

        <TextBlock Text="Talão" Classes="section" />

        <TextBlock Text="Cabeçalho" Classes="label" />
        <TextBox Text="{Binding Header}" PlaceholderText="FESTA DA ALDEIA 2026" FontSize="15" />

        <TextBlock Text="Rodapé" Classes="label" />
        <TextBox Text="{Binding Footer}" PlaceholderText="Obrigado!" FontSize="15" />

        <TextBlock Text="Vazio esconde a linha. Cada linha destas sai em todos os talões da noite."
                   Classes="hint" Margin="0,6,0,0" />

        <CheckBox IsChecked="{Binding ShowPriceOnSenha}" Margin="0,14,0,0"
                  Content="Mostrar o preço nas senhas" />
        <CheckBox IsChecked="{Binding PrintSummarySlip}"
                  Content="Imprimir também um talão com a compra toda" />
        <CheckBox IsChecked="{Binding OpenCashDrawer}"
                  Content="Abrir a gaveta do dinheiro a cada venda" />

        <TextBlock Text="Poupar papel" Classes="section" />

        <CheckBox IsChecked="{Binding ShowRules}" Content="Réguas separadoras" />
        <CheckBox IsChecked="{Binding ShowDate}" Content="Linha da data" />
        <CheckBox IsChecked="{Binding ShowTotalOnGroupSlip}" Content="Total no talão do grupo" />
        <CheckBox IsChecked="{Binding ShowPricesOnGroupSlip}" Content="Preços no talão do grupo" />
        <TextBlock Classes="hint"
                   Text="O talão do resumo para o cliente mantém sempre os preços e o total — é o que tem de bater certo." />

        <Grid ColumnDefinitions="*,*" Margin="0,14,0,0">
          <StackPanel Grid.Column="0" Margin="0,0,8,0">
            <TextBlock Text="Espaçamento entre linhas" Classes="label" Margin="0,0,0,4" />
            <TextBox Text="{Binding LineSpacing}" Classes="numeric" />
            <TextBlock Classes="hint" Text="Pontos. 30 é o normal; 24 encolhe tudo um quinto." />
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="8,0,0,0">
            <TextBlock Text="Avanço antes do corte" Classes="label" Margin="0,0,0,4" />
            <TextBox Text="{Binding FeedLines}" Classes="numeric" />
            <TextBlock Classes="hint" Text="Linhas. É o maior gasto fixo por talão." />
          </StackPanel>
        </Grid>

        <Border Background="#33D97706" CornerRadius="8" Padding="12" Margin="0,10,0,0"
                IsVisible="{Binding FeedTooShort}">
          <TextBlock TextWrapping="Wrap"
                     Text="Com menos de 3 linhas de avanço, a lâmina pode cortar por cima da última linha do talão. Depende da impressora — faça um teste antes do evento." />
        </Border>

        <Border Background="{DynamicResource Surface2}" CornerRadius="8" Padding="12" Margin="0,12,0,0">
          <StackPanel>
            <TextBlock Text="Com estas definições" Classes="hint" Margin="0,0,0,4" />
            <TextBlock Text="{Binding PaperCostText}" TextWrapping="Wrap"
                       FontSize="{DynamicResource TextBody}" />
          </StackPanel>
        </Border>

        <TextBlock Text="Venda" Classes="section" />

        <TextBlock Text="Quando um produto fica sem stock" Classes="label" />
        <ComboBox ItemsSource="{Binding StockBehaviours}" SelectedItem="{Binding StockBehaviour}" />

        <TextBlock Text="Versão" Classes="section" />
        <TextBlock Text="{Binding VersionText}" FontSize="{DynamicResource TextBody}" LineHeight="26" />

        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
          <Button Content="Procurar atualização" Command="{Binding CheckForUpdateCommand}"
                  IsEnabled="{Binding !IsBusyWithUpdate}" />
          <Button Content="Descarregar" Classes="primary" Command="{Binding DownloadUpdateCommand}"
                  IsVisible="{Binding UpdateAvailable}" IsEnabled="{Binding !IsBusyWithUpdate}" />
          <Button Content="Descartar" Classes="danger-quiet" Command="{Binding CancelUpdateCommand}"
                  IsVisible="{Binding UpdateReady}" />
        </StackPanel>

        <TextBlock Text="{Binding UpdateStatus}" Classes="hint" Margin="0,8,0,0"
                   IsVisible="{Binding UpdateStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

        <Border Background="{DynamicResource Surface2}" CornerRadius="8" Padding="12" Margin="0,8,0,0"
                IsVisible="{Binding UpdateNotes, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <StackPanel>
            <TextBlock Text="O que muda" Classes="hint" Margin="0,0,0,4" />
            <TextBlock Text="{Binding UpdateNotes}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <!-- Downloading mid-event is harmless; it is the swap that waits for the
             app to close, and it must never happen with a session open. -->
        <Border Background="#33D97706" CornerRadius="8" Padding="12" Margin="0,8,0,0"
                IsVisible="{Binding UpdateBlockedBySession}">
          <TextBlock TextWrapping="Wrap"
                     Text="Tem uma sessão aberta. Pode descarregar agora, mas feche a sessão e o evento antes de fechar a aplicação — nunca troque de versão a meio de um evento." />
        </Border>

        <TextBlock Text="Dados" Classes="section" />
        <TextBlock Text="{Binding DatabasePath}" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />

        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,24,0,24">
          <Button Content="Guardar" Classes="primary" Width="150" Command="{Binding SaveCommand}" />
          <Button Content="Teste de impressão" Command="{Binding TestPrintCommand}" />
          <Button Content="Cópia de segurança" Command="{Binding BackupCommand}" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="1" Padding="20,12" Background="{DynamicResource Surface1}" BorderBrush="{DynamicResource LineSoft}" BorderThickness="0,1,0,0">
      <TextBlock Text="{Binding StatusMessage}" FontSize="14" TextWrapping="Wrap" />
    </Border>
  </Grid>
</UserControl>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SellingPoint.App.ViewModels"
        xmlns:views="using:SellingPoint.App.Views"
        x:Class="SellingPoint.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/senhas.ico"
        Title="Senhas do Calvário"
        MinWidth="1024" MinHeight="600"
        WindowState="FullScreen">

  <Grid RowDefinitions="*,Auto">
    <Grid Grid.Row="0">
    <TabControl SelectedIndex="{Binding SelectedTab}">
      <TabItem Header="Venda">
        <views:VendaView DataContext="{Binding Venda}" />
      </TabItem>
      <TabItem Header="Gestão">
        <views:GestaoView DataContext="{Binding Gestao}" />
      </TabItem>
      <TabItem Header="Relatórios">
        <views:RelatoriosView DataContext="{Binding Relatorios}" />
      </TabItem>
      <TabItem Header="Definições">
        <views:DefinicoesView DataContext="{Binding Definicoes}" />
      </TabItem>
    </TabControl>

    <!--
      In fullscreen, Windows shows nothing at all: no title bar, and no
      reveal-on-hover the way macOS does. Without a visible button here, someone
      at the event has no way out they could guess. Sits over the tab strip,
      right-aligned, so it is on screen in every tab.
    -->
    <Button Name="FullScreenToggle" Classes="quiet"
            HorizontalAlignment="Right" VerticalAlignment="Top"
            Margin="0,8,16,0" FontSize="13"
            ToolTip.Tip="F11"
            Click="OnToggleFullScreen" />
    </Grid>

    <!-- Docked, not floating: the app shrinks above it rather than being covered. -->
    <views:TouchKeyboardView Grid.Row="1" DataContext="{Binding Keyboard}"
                             IsVisible="{Binding IsVisible}" />
  </Grid>
</Window>

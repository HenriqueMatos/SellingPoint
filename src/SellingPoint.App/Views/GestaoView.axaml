<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SellingPoint.App.ViewModels"
             x:Class="SellingPoint.App.Views.GestaoView"
             x:DataType="vm:GestaoViewModel">

  <UserControl.Styles>
    <Style Selector="Border.forma">
      <Setter Property="Margin" Value="16" />
    </Style>
    <!-- Sub-tabs are smaller than the top-level ones so the hierarchy reads -->
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="{DynamicResource TextBody}" />
      <Setter Property="Padding" Value="16,10" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="*,Auto">
    <TabControl Grid.Row="0" Margin="8,4,8,0">

      <!-- Categories -->
      <TabItem Header="Categorias">
        <Grid ColumnDefinitions="360,*">
          <Border Grid.Column="0" Classes="panel forma">
            <Grid RowDefinitions="*,Auto">
              <ListBox Grid.Row="0" ItemsSource="{Binding CategoryRows}"
                       SelectedItem="{Binding SelectedCategory}" Background="Transparent">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:CategoryRowViewModel">
                    <StackPanel Margin="0,4">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" LineHeight="26" />
                      <TextBlock Text="{Binding Detail}" FontSize="11" Opacity="0.6" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" Margin="0,10,0,0">
                <Button Content="Nova" Command="{Binding NewCategoryCommand}" />
                <Button Content="↑" Width="56" Command="{Binding MoveCategoryUpCommand}" />
                <Button Content="↓" Width="56" Command="{Binding MoveCategoryDownCommand}" />
              </StackPanel>
            </Grid>
          </Border>

          <Border Grid.Column="1" Classes="panel forma">
            <ScrollViewer>
              <StackPanel MaxWidth="520" HorizontalAlignment="Left">
                <TextBlock Text="Nome" Classes="label" />
                <TextBox Text="{Binding CategoryName}" FontSize="16" />

                <TextBlock Text="Cor do botão" Classes="label" />
                <Grid ColumnDefinitions="*,Auto">
                  <TextBox Grid.Column="0" Text="{Binding CategoryColor}" FontSize="16" />
                  <Border Grid.Column="1" Width="48" Margin="8,0,0,0" CornerRadius="6"
                          Background="{Binding CategoryColor}" />
                </Grid>

                <TextBlock Text="Grupo de impressão" Classes="label" />
                <ComboBox ItemsSource="{Binding PrintGroups}" SelectedItem="{Binding CategoryPrintGroup}"
                          HorizontalAlignment="Stretch" FontSize="16" />
                <TextBox Text="{Binding CategoryPrintGroup}" Margin="0,6,0,0" FontSize="16"
                         PlaceholderText="ou escreva um grupo novo" />
                <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.6" Margin="0,6,0,0"
                           Text="Cada categoria sai no seu próprio talão. Para juntar duas categorias no mesmo talão, dê-lhes o mesmo grupo." />

                <CheckBox IsChecked="{Binding CategoryPerUnit}" Margin="0,14,0,0"
                          Content="Uma senha por unidade" />
                <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.6"
                           Text="Ligado: 3 cervejas imprimem 3 senhas. Desligado: sai uma linha &quot;3x Cerveja&quot; no talão do grupo." />

                <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,26,0,0">
                  <Button Content="Guardar" Classes="primary" Width="140" Command="{Binding SaveCategoryCommand}" />
                  <Button Content="Apagar" Classes="danger-quiet" Width="120"
                          Command="{Binding DeleteCategoryCommand}" />
                </StackPanel>
              </StackPanel>
            </ScrollViewer>
          </Border>
        </Grid>
      </TabItem>

      <!-- Products -->
      <TabItem Header="Produtos">
        <Grid ColumnDefinitions="420,*">
          <Border Grid.Column="0" Classes="panel forma">
            <Grid RowDefinitions="Auto,Auto,*,Auto">

              <!-- Which category's products are on screen -->
              <ListBox Grid.Row="0" ItemsSource="{Binding ProductFilters}"
                       SelectedItem="{Binding SelectedProductFilter}" Margin="0,0,0,10">
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.Styles>
                  <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,8,8" />
                    <Setter Property="Opacity" Value="0.6" />
                  </Style>
                  <Style Selector="ListBoxItem:selected">
                    <Setter Property="Opacity" Value="1" />
                  </Style>
                  <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                    <Setter Property="Background" Value="Transparent" />
                  </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:ProductFilterViewModel">
                    <Border Background="{Binding Background}" CornerRadius="8" Padding="14,9">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding Name}" Foreground="White" LineHeight="24"
                                   FontWeight="SemiBold" />
                        <Border Background="#59000000" CornerRadius="999" Padding="7,1"
                                VerticalAlignment="Center">
                          <TextBlock Text="{Binding Count}" Foreground="White" FontSize="11" />
                        </Border>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

              <TextBlock Grid.Row="1" Text="{Binding ProductCountText}" Classes="section" />

              <ListBox Grid.Row="2" ItemsSource="{Binding ProductRows}"
                       SelectedItem="{Binding SelectedProduct}" Background="Transparent">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:ProductRowViewModel">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,4" Opacity="{Binding Opacity}">
                      <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" LineHeight="26" />
                        <TextBlock Text="{Binding Detail}" FontSize="11" Opacity="0.6" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="{Binding PriceText}" FontSize="15"
                                 VerticalAlignment="Center" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="6" Margin="0,10,0,0">
                <Button Content="Novo" Command="{Binding NewProductCommand}" />
                <Button Content="↑" Width="56" Command="{Binding MoveProductUpCommand}" />
                <Button Content="↓" Width="56" Command="{Binding MoveProductDownCommand}" />
              </StackPanel>
            </Grid>
          </Border>

          <Border Grid.Column="1" Classes="panel forma">
            <ScrollViewer>
              <StackPanel MaxWidth="520" HorizontalAlignment="Left">
                <TextBlock Text="Nome" Classes="label" />
                <TextBox Text="{Binding ProductName}" FontSize="16" />

                <TextBlock Text="Preço" Classes="label" />
                <TextBox Text="{Binding ProductPrice}" PlaceholderText="1,50" Classes="numeric" FontSize="16" />

                <TextBlock Text="Categoria" Classes="label" />
                <ComboBox ItemsSource="{Binding CategoryChoices}" SelectedItem="{Binding ProductCategory}"
                          HorizontalAlignment="Stretch" FontSize="16">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:CategoryRowViewModel">
                      <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>

                <CheckBox IsChecked="{Binding ProductActive}" Margin="0,16,0,0"
                          Content="Ativo (aparece na venda)" />
                <CheckBox IsChecked="{Binding ProductTrackStock}" Content="Controlar stock" />

                <TextBlock Text="Stock" Classes="label" IsVisible="{Binding ProductTrackStock}" />
                <TextBox Text="{Binding ProductStock}" Classes="numeric" FontSize="16" Width="140"
                         HorizontalAlignment="Left" IsVisible="{Binding ProductTrackStock}" />

                <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,26,0,0">
                  <Button Content="Guardar" Classes="primary" Width="140" Command="{Binding SaveProductCommand}" />
                  <Button Content="Apagar" Classes="danger-quiet" Width="120"
                          Command="{Binding DeleteProductCommand}" />
                </StackPanel>
              </StackPanel>
            </ScrollViewer>
          </Border>
        </Grid>
      </TabItem>
    </TabControl>

    <Border Grid.Row="1" Padding="20,12" Background="{DynamicResource Surface1}" BorderBrush="{DynamicResource LineSoft}" BorderThickness="0,1,0,0">
      <TextBlock Text="{Binding StatusMessage}" FontSize="14" />
    </Border>
  </Grid>
</UserControl>

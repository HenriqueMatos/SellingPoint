<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SellingPoint.App.ViewModels"
             xmlns:views="using:SellingPoint.App.Views"
             x:Class="SellingPoint.App.Views.VendaView"
             x:DataType="vm:VendaViewModel">

  <UserControl.Styles>
    <!-- A product is the most-tapped thing in the app. Big, high contrast, and
         the price large enough to read while counting change. -->
    <Style Selector="Button.produto">
      <Setter Property="Width" Value="208" />
      <Setter Property="Height" Value="136" />
      <Setter Property="Margin" Value="0,0,12,12" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
    </Style>

    <Style Selector="Button.tecla">
      <Setter Property="Width" Value="104" />
      <Setter Property="Height" Value="76" />
      <Setter Property="Margin" Value="5" />
      <Setter Property="FontSize" Value="24" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="Border.overlay-card">
      <Setter Property="Background" Value="{DynamicResource Surface1}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusLarge}" />
      <Setter Property="Padding" Value="28" />
      <Setter Property="MinWidth" Value="460" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="BoxShadow" Value="0 24 64 0 #99000000" />
    </Style>
  </UserControl.Styles>

  <Grid>
    <Grid RowDefinitions="Auto,*,Auto">

      <!-- Top bar: which session, and is paper coming out -->
      <Border Grid.Row="0" Padding="20,12" Background="{DynamicResource Surface1}"
              BorderBrush="{DynamicResource LineSoft}" BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
          <StackPanel Grid.Column="0" VerticalAlignment="Center">
            <TextBlock Text="Sessão" Classes="section" Margin="0,0,0,2" />
            <TextBlock Text="{Binding SessionText}" FontSize="{DynamicResource TextLarge}"
                       LineHeight="32" FontWeight="SemiBold" />
          </StackPanel>

          <!-- The printer light. Tapping it opens the diagnostics without leaving
               the till screen, which is where you are when it stops working. -->
          <Button Grid.Column="2" Classes="pill quiet" Margin="0,0,10,0"
                  Command="{Binding OpenDiagnosticsCommand}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Ellipse Width="12" Height="12" Fill="{Binding PrinterChipBrush}"
                       VerticalAlignment="Center" />
              <TextBlock Text="{Binding PrinterChipText}" VerticalAlignment="Center"
                         FontSize="{DynamicResource TextSmall}" />
            </StackPanel>
          </Button>

          <Button Grid.Column="3" Content="Abrir sessão" Classes="primary"
                  Margin="0,0,10,0" IsVisible="{Binding !HasOpenSession}"
                  Command="{Binding OpenSessionPanelCommand}" />

          <ToggleButton Grid.Column="4" Content="Ver talão" Padding="16,10"
                        CornerRadius="6" IsChecked="{Binding IsPreviewVisible}"
                        Command="{Binding TogglePreviewCommand}" />
        </Grid>
      </Border>

      <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto">

        <!-- Categories and products -->
        <Grid Grid.Column="0" RowDefinitions="Auto,*" Margin="20,18,8,18">
          <ListBox Grid.Row="0" ItemsSource="{Binding Categories}"
                   SelectedItem="{Binding SelectedCategory}" Margin="0,0,0,18">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.Styles>
              <!-- The unselected chip is the category colour at low opacity; the
                   selected one is solid with a light ring. Readable at a glance
                   from arm's length, which a subtle highlight is not. -->
              <Style Selector="ListBoxItem">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,0,10,0" />
                <Setter Property="Opacity" Value="0.68" />
              </Style>
              <Style Selector="ListBoxItem:selected">
                <Setter Property="Opacity" Value="1" />
              </Style>
              <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                <Setter Property="Background" Value="Transparent" />
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:CategoryTabViewModel">
                <Border Background="{Binding Background}" CornerRadius="10" Padding="22,13"
                        BorderBrush="{Binding RingBrush}" BorderThickness="2">
                  <TextBlock Text="{Binding Name}" Foreground="White" LineHeight="32"
                             FontSize="{DynamicResource TextLarge}" FontWeight="SemiBold" />
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <ScrollViewer Grid.Row="1">
            <ItemsControl ItemsSource="{Binding Products}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ProductButtonViewModel">
                  <Button Classes="produto" Command="{Binding PressCommand}"
                          Opacity="{Binding Opacity}">
                    <Border Background="{Binding Background}" CornerRadius="12" Padding="14,12">
                    <Grid RowDefinitions="*,Auto">
                      <TextBlock Grid.Row="0" Text="{Binding Name}" FontSize="17" LineHeight="30"
                                 FontWeight="SemiBold" TextWrapping="Wrap" Foreground="White" />
                      <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{Binding PriceText}" FontSize="22"
                                   FontWeight="Bold" Foreground="White" />
                        <Border Grid.Column="1" Background="#59000000" CornerRadius="999"
                                Padding="9,3" VerticalAlignment="Center"
                                IsVisible="{Binding ShowStock}">
                          <TextBlock Text="{Binding StockText}" FontSize="12"
                                     FontWeight="SemiBold" Foreground="White" />
                        </Border>
                      </Grid>
                    </Grid>
                    </Border>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>

        <!-- Cart -->
        <Border Grid.Column="1" Classes="panel" Width="400" Margin="8,18,20,18">
          <Grid RowDefinitions="Auto,*,Auto,Auto">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
              <TextBlock Grid.Column="0" Text="Carrinho" Classes="section" Margin="0" />
              <TextBlock Grid.Column="1" Text="{Binding CartCountText}" Classes="section" Margin="0" />
            </Grid>

            <!-- An empty cart says what to do rather than showing a void -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center" IsVisible="{Binding IsCartEmpty}">
              <TextBlock Text="Toque nos produtos para os juntar aqui"
                         Classes="hint" HorizontalAlignment="Center" TextAlignment="Center" />
            </StackPanel>

            <ScrollViewer Grid.Row="1" IsVisible="{Binding !IsCartEmpty}">
              <ItemsControl ItemsSource="{Binding CartLines}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:CartLineViewModel">
                    <Border Classes="card" Margin="0,0,0,8">
                      <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="10">
                          <Border Background="{DynamicResource Surface3}" CornerRadius="6"
                                  Padding="8,2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding QtyText}" FontWeight="Bold"
                                       FontSize="{DynamicResource TextBody}" />
                          </Border>
                          <TextBlock Text="{Binding Name}" TextWrapping="Wrap" LineHeight="26"
                                     FontSize="{DynamicResource TextBody}"
                                     VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding TotalText}"
                                   FontWeight="Bold" FontSize="{DynamicResource TextLarge}"
                                   VerticalAlignment="Center" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding UnitText}"
                                   Classes="hint" Margin="0,6,0,0" VerticalAlignment="Center" />

                        <!-- 44px targets, 8px apart -->
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal"
                                    Spacing="10" HorizontalAlignment="Right" Margin="0,10,0,0">
                          <Button Classes="stepper" Content="−" Command="{Binding DecrementCommand}" />
                          <Button Classes="stepper" Content="+" Command="{Binding IncrementCommand}" />
                          <Button Classes="stepper danger" Content="✕" Command="{Binding RemoveCommand}" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>

            <!-- The total is the number everyone in the queue is looking at -->
            <Border Grid.Row="2" Background="{DynamicResource MoneyGlow}" CornerRadius="12"
                    Padding="18,14" Margin="0,14,0,12"
                    BorderBrush="{DynamicResource MoneyDeep}" BorderThickness="1">
              <Grid ColumnDefinitions="Auto,*">
                <TextBlock Grid.Column="0" Text="TOTAL" FontSize="{DynamicResource TextLarge}"
                           FontWeight="Bold" VerticalAlignment="Center"
                           Foreground="{DynamicResource InkMuted}" />
                <TextBlock Grid.Column="1" Text="{Binding TotalText}"
                           FontSize="{DynamicResource TextHuge}" FontWeight="Bold"
                           Foreground="{DynamicResource Money}"
                           HorizontalAlignment="Right" />
              </Grid>
            </Border>

            <StackPanel Grid.Row="3" Spacing="8">
              <Grid ColumnDefinitions="*,*,*">
                <Button Grid.Column="0" Content="Limpar" Classes="quiet" HorizontalAlignment="Stretch"
                        Height="{DynamicResource TapSmall}" Margin="0,0,3,0"
                        Command="{Binding ClearCartCommand}" IsEnabled="{Binding !IsCartEmpty}" />
                <Button Grid.Column="1" Content="Reimprimir" Classes="quiet" HorizontalAlignment="Stretch"
                        Height="{DynamicResource TapSmall}" Margin="3,0,3,0"
                        Command="{Binding ReprintLastCommand}" IsEnabled="{Binding CanReprint}" />
                <!-- Someone holding a slip from an hour ago. Reprint only ever
                     reached the last sale. -->
                <Button Grid.Column="2" Content="Procurar" Classes="quiet" HorizontalAlignment="Stretch"
                        Height="{DynamicResource TapSmall}" Margin="3,0,0,0"
                        Command="{Binding OpenTicketSearchCommand}" IsEnabled="{Binding HasOpenSession}" />
              </Grid>
              <Grid ColumnDefinitions="*,*">
                <Button Grid.Column="0" Classes="primary" HorizontalAlignment="Stretch"
                        Height="{DynamicResource TapLarge}" FontSize="{DynamicResource TextTitle}"
                        Margin="0,0,4,0" Command="{Binding OpenCashPanelCommand}"
                        IsEnabled="{Binding CanPay}" Content="Dinheiro" />
                <Button Grid.Column="1" Classes="card-pay" HorizontalAlignment="Stretch"
                        Height="{DynamicResource TapLarge}" FontSize="{DynamicResource TextTitle}"
                        Margin="4,0,0,0" Command="{Binding PayCardCommand}"
                        IsEnabled="{Binding CanPay}" Content="Cartão" />
              </Grid>
            </StackPanel>
          </Grid>
        </Border>

        <!-- Ticket preview -->
        <Border Grid.Column="2" Width="400" Margin="0,18,20,18" Padding="18"
                CornerRadius="14" Background="#080D18"
                BorderBrush="{DynamicResource LineSoft}" BorderThickness="1"
                IsVisible="{Binding IsPreviewVisible}">
          <Grid RowDefinitions="Auto,*">
            <TextBlock Grid.Row="0" Text="Talão" Classes="section" />
            <ScrollViewer Grid.Row="1">
              <TextBlock Text="{Binding PreviewText}" FontFamily="Menlo,Consolas,monospace"
                         FontSize="12" Foreground="{DynamicResource InkMuted}" />
            </ScrollViewer>
          </Grid>
        </Border>
      </Grid>

      <!-- Status line, only when it has something to say -->
      <Border Grid.Row="2" Padding="20,12" Background="{DynamicResource Surface1}"
              BorderBrush="{DynamicResource LineSoft}" BorderThickness="0,1,0,0"
              IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <TextBlock Text="{Binding StatusMessage}" FontSize="{DynamicResource TextBody}"
                   TextWrapping="Wrap" />
      </Border>
    </Grid>

    <!--
      Cash overlay. Two columns rather than one tall stack: stacked, the numpad
      pushed the confirm button to around 760px from the top, which on a 768px
      touch screen put it at or past the bottom edge with no way to reach it.
      Side by side it comes in around 400px and fits any panel we are likely to
      meet.
    -->
    <Grid Background="#CC020617" IsVisible="{Binding IsCashPanelOpen}">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <Border Classes="overlay-card" MinWidth="760" Margin="16">
        <Grid ColumnDefinitions="*,Auto" RowDefinitions="*,Auto">

          <!-- What is owed, what was handed over, what goes back -->
          <StackPanel Grid.Row="0" Grid.Column="0" Spacing="14" MinWidth="330" Margin="0,0,24,0">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Text="A pagar" FontSize="{DynamicResource TextLarge}"
                         Foreground="{DynamicResource InkMuted}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{Binding TotalText}"
                         FontSize="{DynamicResource TextDisplay}" FontWeight="Bold" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Text="Recebido" FontSize="{DynamicResource TextLarge}"
                         Foreground="{DynamicResource InkMuted}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{Binding CashReceivedText}"
                         FontSize="{DynamicResource TextDisplay}" />
            </Grid>

            <Border Background="{DynamicResource Cash}" CornerRadius="12" Padding="18,14">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="TROCO" FontSize="{DynamicResource TextTitle}"
                           FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding ChangeText}"
                           FontSize="{DynamicResource TextHuge}" FontWeight="Bold" Foreground="White" />
              </Grid>
            </Border>

            <ItemsControl ItemsSource="{Binding QuickTenders}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:QuickTenderViewModel">
                  <Button Content="{Binding Label}" Command="{Binding PressCommand}"
                          MinWidth="100" Margin="0,0,8,8"
                          FontSize="{DynamicResource TextLarge}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <!-- Numpad -->
          <WrapPanel Grid.Row="0" Grid.Column="1" MaxWidth="354" VerticalAlignment="Top">
            <Button Classes="tecla" Content="1" Command="{Binding CashDigitCommand}" CommandParameter="1" />
            <Button Classes="tecla" Content="2" Command="{Binding CashDigitCommand}" CommandParameter="2" />
            <Button Classes="tecla" Content="3" Command="{Binding CashDigitCommand}" CommandParameter="3" />
            <Button Classes="tecla" Content="4" Command="{Binding CashDigitCommand}" CommandParameter="4" />
            <Button Classes="tecla" Content="5" Command="{Binding CashDigitCommand}" CommandParameter="5" />
            <Button Classes="tecla" Content="6" Command="{Binding CashDigitCommand}" CommandParameter="6" />
            <Button Classes="tecla" Content="7" Command="{Binding CashDigitCommand}" CommandParameter="7" />
            <Button Classes="tecla" Content="8" Command="{Binding CashDigitCommand}" CommandParameter="8" />
            <Button Classes="tecla" Content="9" Command="{Binding CashDigitCommand}" CommandParameter="9" />
            <Button Classes="tecla" Content="0" Command="{Binding CashDigitCommand}" CommandParameter="0" />
            <Button Classes="tecla" Content="00" Command="{Binding CashDigitCommand}" CommandParameter="00" />
            <Button Classes="tecla quiet" Content="C" Command="{Binding CashClearCommand}" />
          </WrapPanel>

          <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" ColumnDefinitions="*,*" Margin="0,20,0,0">
            <Button Grid.Column="0" Content="Cancelar" Classes="quiet" Height="64"
                    HorizontalAlignment="Stretch" Margin="0,0,6,0"
                    Command="{Binding CloseCashPanelCommand}" />
            <Button Grid.Column="1" Content="Confirmar e imprimir" Classes="primary" Height="64"
                    HorizontalAlignment="Stretch" Margin="6,0,0,0"
                    FontSize="{DynamicResource TextLarge}"
                    Command="{Binding ConfirmCashCommand}" IsEnabled="{Binding CanConfirmCash}" />
          </Grid>
        </Grid>
      </Border>
      </ScrollViewer>
    </Grid>

    <!--
      Looking up a slip a customer is holding. Same shape as the cash panel: the
      numpad on the right, what it found on the left, so a thumb that knows one
      knows the other.
    -->
    <Grid Background="#CC020617" IsVisible="{Binding IsTicketSearchOpen}">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <Border Classes="overlay-card" MinWidth="760" Margin="16">
        <Grid ColumnDefinitions="*,Auto" RowDefinitions="*,Auto">

          <StackPanel Grid.Row="0" Grid.Column="0" Spacing="14" MinWidth="330" Margin="0,0,24,0">
            <TextBlock Text="Procurar talão" FontSize="{DynamicResource TextTitle}" FontWeight="Bold" />
            <TextBlock Text="O número que está impresso no talão, sem o cardinal."
                       Classes="hint" TextWrapping="Wrap" />

            <Border Background="{DynamicResource Surface3}" CornerRadius="12" Padding="18,14">
              <TextBlock Text="{Binding TicketSearchEntry}" FontSize="{DynamicResource TextDisplay}"
                         FontWeight="Bold" HorizontalAlignment="Center" MinHeight="42" />
            </Border>

            <Border Background="{DynamicResource Surface2}" CornerRadius="12" Padding="16"
                    IsVisible="{Binding TicketSearchResult, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
              <TextBlock Text="{Binding TicketSearchResult}" TextWrapping="Wrap"
                         FontFamily="Menlo,Consolas,monospace" LineHeight="26"
                         FontSize="{DynamicResource TextBody}" />
            </Border>
          </StackPanel>

          <WrapPanel Grid.Row="0" Grid.Column="1" MaxWidth="354" VerticalAlignment="Top">
            <Button Classes="tecla" Content="1" Command="{Binding TicketSearchDigitCommand}" CommandParameter="1" />
            <Button Classes="tecla" Content="2" Command="{Binding TicketSearchDigitCommand}" CommandParameter="2" />
            <Button Classes="tecla" Content="3" Command="{Binding TicketSearchDigitCommand}" CommandParameter="3" />
            <Button Classes="tecla" Content="4" Command="{Binding TicketSearchDigitCommand}" CommandParameter="4" />
            <Button Classes="tecla" Content="5" Command="{Binding TicketSearchDigitCommand}" CommandParameter="5" />
            <Button Classes="tecla" Content="6" Command="{Binding TicketSearchDigitCommand}" CommandParameter="6" />
            <Button Classes="tecla" Content="7" Command="{Binding TicketSearchDigitCommand}" CommandParameter="7" />
            <Button Classes="tecla" Content="8" Command="{Binding TicketSearchDigitCommand}" CommandParameter="8" />
            <Button Classes="tecla" Content="9" Command="{Binding TicketSearchDigitCommand}" CommandParameter="9" />
            <Button Classes="tecla" Content="0" Command="{Binding TicketSearchDigitCommand}" CommandParameter="0" />
            <Button Classes="tecla quiet" Content="C" Command="{Binding TicketSearchClearCommand}" />
            <Button Classes="tecla primary" Content="🔍" Command="{Binding FindTicketCommand}" />
          </WrapPanel>

          <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" ColumnDefinitions="*,*" Margin="0,20,0,0">
            <Button Grid.Column="0" Content="Fechar" Classes="quiet" Height="64"
                    HorizontalAlignment="Stretch" Margin="0,0,6,0"
                    Command="{Binding CloseTicketSearchCommand}" />
            <Button Grid.Column="1" Content="Reimprimir este talão" Classes="primary" Height="64"
                    HorizontalAlignment="Stretch" Margin="6,0,0,0"
                    FontSize="{DynamicResource TextLarge}"
                    Command="{Binding ReprintFoundCommand}" IsEnabled="{Binding HasFoundTicket}" />
          </Grid>
        </Grid>
      </Border>
      </ScrollViewer>
    </Grid>

    <!-- Printer diagnostics overlay -->
    <Grid Background="#CC020617" IsVisible="{Binding IsDiagnosticsOpen}">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <Border Classes="overlay-card" MinWidth="680" Margin="16">
        <Grid RowDefinitions="*,Auto">
          <views:PrinterDiagnosticsView Grid.Row="0" DataContext="{Binding Diagnostics}" />
          <Button Grid.Row="1" Content="Fechar" HorizontalAlignment="Stretch"
                  Margin="0,18,0,0" Command="{Binding CloseDiagnosticsCommand}" />
        </Grid>
      </Border>
      </ScrollViewer>
    </Grid>

    <!-- Open-session overlay -->
    <Grid Background="#CC020617" IsVisible="{Binding IsSessionPanelOpen}">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <Border Classes="overlay-card" Margin="16">
        <StackPanel Spacing="8">
          <TextBlock Text="Abrir sessão" FontSize="{DynamicResource TextTitle}" FontWeight="Bold" />

          <!-- Asked for once, when there is not one running. Every night after that
               joins it without anybody being asked - but the name is always shown,
               and starting a new one is always offered, because a festival stays
               open until somebody ends it and next August must not quietly join
               last August. -->
          <TextBlock Text="{Binding EventText}" Classes="hint" TextWrapping="Wrap"
                     IsVisible="{Binding !NeedsEvent}" />
          <CheckBox IsChecked="{Binding StartNewEvent}" IsVisible="{Binding !NeedsEvent}"
                    Content="É outra festa — começar uma nova" />

          <StackPanel Spacing="8" IsVisible="{Binding AsksForEventName}">
            <TextBlock Text="Festa" Classes="label" />
            <TextBox Text="{Binding EventNameEntry}" />
            <TextBlock Classes="hint" TextWrapping="Wrap"
                       Text="As noites desta festa ficam juntas, e no fim há um total de todas." />
          </StackPanel>

          <TextBlock Text="Noite" Classes="label" />
          <TextBox Text="{Binding SessionNameEntry}" />
          <TextBlock Text="Fundo de caixa (opcional)" Classes="label" />
          <TextBox Text="{Binding SessionFloatEntry}" PlaceholderText="0,00" Classes="numeric" />
          <Grid ColumnDefinitions="*,*" Margin="0,18,0,0">
            <Button Grid.Column="0" Content="Cancelar" Classes="quiet"
                    HorizontalAlignment="Stretch" Margin="0,0,5,0"
                    Command="{Binding CloseSessionPanelCommand}" />
            <Button Grid.Column="1" Content="Abrir" Classes="primary"
                    HorizontalAlignment="Stretch" Margin="5,0,0,0"
                    Command="{Binding ConfirmOpenSessionCommand}" />
          </Grid>
        </StackPanel>
      </Border>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>

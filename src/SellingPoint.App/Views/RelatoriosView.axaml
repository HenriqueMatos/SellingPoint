<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SellingPoint.App.ViewModels"
             x:Class="SellingPoint.App.Views.RelatoriosView"
             x:DataType="vm:RelatoriosViewModel">

  <UserControl.Styles>
    <Style Selector="Border.cartao">
      <Setter Property="Margin" Value="0,0,0,14" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="*,Auto">
    <Grid Grid.Row="0" ColumnDefinitions="340,*" Margin="20,18,20,0">

      <!-- Session list -->
      <Border Grid.Column="0" Classes="panel cartao" Margin="0,0,12,0">
        <Grid RowDefinitions="Auto,*">
          <TextBlock Grid.Row="0" Text="Festas e noites" Classes="section" />
          <!-- Festivals in bold with their nights indented under them. One list of
               two kinds rather than a tree: a tree means a disclosure arrow to hit
               with a finger, and there are only ever a handful of rows. -->
          <ListBox Grid.Row="1" ItemsSource="{Binding Sessions}"
                   SelectedItem="{Binding SelectedSession}" Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:SessionRowViewModel">
                <StackPanel Margin="{Binding Indent}">
                  <TextBlock Text="{Binding Name}" FontWeight="{Binding Weight}"
                             FontSize="15" LineHeight="26" />
                  <TextBlock Text="{Binding Detail}" FontSize="{DynamicResource TextSmall}"
                             Foreground="{DynamicResource InkMuted}" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <ScrollViewer Grid.Column="1" IsVisible="{Binding HasReport}">
        <StackPanel>

          <!-- Money -->
          <!-- Two rows of two rather than four across. On the 1024-wide screen this
               has to run on, four equal columns leave about 150px each, and a good
               night's total at 30px needs more than that - a TextBlock clips with
               no ellipsis, so "1.234,56 EUR" would have been read as "1.234,5" at
               cash-up and counted against. -->
          <!-- Whose numbers these are: a festival or one of its nights. -->
          <Border Classes="panel cartao">
            <StackPanel>
              <TextBlock Text="{Binding Title}" FontSize="{DynamicResource TextTitle}" FontWeight="Bold" />
              <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource InkMuted}"
                         IsVisible="{Binding Subtitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
          </Border>

          <Border Classes="panel cartao">
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto">
              <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,10">
                <TextBlock Text="Vendas" Foreground="{DynamicResource InkMuted}" />
                <TextBlock Text="{Binding SalesCountText}" FontSize="30" FontWeight="Bold" />
              </StackPanel>
              <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
                <TextBlock Text="Total" Foreground="{DynamicResource InkMuted}" />
                <TextBlock Text="{Binding TotalText}" FontSize="30" FontWeight="Bold" />
              </StackPanel>
              <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,0">
                <TextBlock Text="Dinheiro" Foreground="{DynamicResource InkMuted}" />
                <TextBlock Text="{Binding CashText}" FontSize="26" />
              </StackPanel>
              <StackPanel Grid.Row="1" Grid.Column="1">
                <TextBlock Text="Cartão" Foreground="{DynamicResource InkMuted}" />
                <TextBlock Text="{Binding CardText}" FontSize="26" />
              </StackPanel>
              <!-- Below the line, and only when there were any: what was given away
                   is not takings, and a night without offers should not carry a
                   zero that invites the question. -->
              <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,10,12,0"
                          IsVisible="{Binding HasOffers}">
                <TextBlock Text="Ofertas" Foreground="{DynamicResource InkMuted}" />
                <TextBlock Text="{Binding OfferText}" FontSize="26"
                           Foreground="{DynamicResource Money}" />
              </StackPanel>
            </Grid>
          </Border>

          <!-- Cash reconciliation -->
          <Border Classes="panel cartao">
            <StackPanel>
              <TextBlock Text="Caixa" Classes="section" />
              <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                <TextBlock Grid.Column="0" Text="Fundo de caixa" />
                <TextBlock Grid.Column="1" Text="{Binding FloatText}" />
              </Grid>
              <!-- Every movement, not just their total: at two in the morning the
                   question is not how much left the drawer but who carried it. -->
              <ItemsControl ItemsSource="{Binding MovementLines}" IsVisible="{Binding HasMovements}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:AmountRowViewModel">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding Name}" />
                        <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource InkMuted}" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="{Binding TotalText}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                <TextBlock Grid.Column="0" Text="Dinheiro esperado na caixa" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1" Text="{Binding ExpectedCashText}" FontWeight="SemiBold" />
              </Grid>
              <Grid ColumnDefinitions="*,Auto" Margin="0,2" IsVisible="{Binding HasVariance}">
                <TextBlock Grid.Column="0" Text="Dinheiro contado" />
                <TextBlock Grid.Column="1" Text="{Binding CountedCashText}" />
              </Grid>
              <Grid ColumnDefinitions="*,Auto" Margin="0,2" IsVisible="{Binding HasVariance}">
                <TextBlock Grid.Column="0" Text="Diferença" FontWeight="Bold" />
                <TextBlock Grid.Column="1" Text="{Binding VarianceText}" FontWeight="Bold" />
              </Grid>

              <!-- A night nobody counted is money the difference above knows
                   nothing about, and the difference looking right is exactly when
                   that matters most. -->
              <Border Background="#33D97706" CornerRadius="8" Padding="12" Margin="0,10,0,0"
                      IsVisible="{Binding UncountedText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding UncountedText}" TextWrapping="Wrap" />
              </Border>

              <!-- Sangria. Sits with the session open only: a closed session has
                   been counted, and moving its cash afterwards would change a
                   figure somebody already signed off on. -->
              <StackPanel IsVisible="{Binding IsSessionOpen}" Margin="0,16,0,0" Spacing="6">
                <TextBlock Text="Registar dinheiro retirado da caixa"
                           Foreground="{DynamicResource InkMuted}" />
                <Grid ColumnDefinitions="160,*,Auto">
                  <TextBox Grid.Column="0" Text="{Binding WithdrawalEntry}" PlaceholderText="0,00"
                           Classes="numeric" FontSize="16" />
                  <TextBox Grid.Column="1" Text="{Binding WithdrawalReason}" Margin="8,0,0,0"
                           PlaceholderText="Porquê — por exemplo, levado ao carro" FontSize="16" />
                  <Button Grid.Column="2" Content="Registar saída" Margin="8,0,0,0"
                          Command="{Binding RecordWithdrawalCommand}" />
                </Grid>
              </StackPanel>

              <StackPanel IsVisible="{Binding IsSessionOpen}" Margin="0,20,0,0" Spacing="6">
                <TextBlock Text="Fechar a sessão — conte o dinheiro na caixa"
                           Foreground="{DynamicResource InkMuted}" />
                <Grid ColumnDefinitions="200,Auto">
                  <TextBox Grid.Column="0" Text="{Binding CountedEntry}" PlaceholderText="0,00" Classes="numeric" FontSize="16" />
                  <!-- Not the primary green: that is Guardar everywhere else in the
                       app, and this one ends the night with no way back. Asks on
                       the first tap, naming the amount it would close on. -->
                  <Button Grid.Column="1" Content="{Binding CloseSessionLabel}" Margin="24,0,0,0"
                          Classes="danger-quiet" Classes.armed="{Binding CloseArmed}"
                          Command="{Binding CloseSessionCommand}" />
                </Grid>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Per product -->
          <Border Classes="panel cartao">
            <StackPanel>
              <TextBlock Text="Por produto" Classes="section" />
              <ItemsControl ItemsSource="{Binding ProductLines}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:AmountRowViewModel">
                    <Grid ColumnDefinitions="*,60,90" Margin="0,3">
                      <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding Name}" LineHeight="26" />
                        <TextBlock Text="{Binding Detail}" FontSize="{DynamicResource TextSmall}" Foreground="{DynamicResource InkMuted}" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="{Binding UnitsText}" HorizontalAlignment="Right" />
                      <TextBlock Grid.Column="2" Text="{Binding TotalText}" HorizontalAlignment="Right"
                                 FontWeight="SemiBold" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <!-- Per category -->
          <Border Classes="panel cartao">
            <StackPanel>
              <TextBlock Text="Por categoria" Classes="section" />
              <ItemsControl ItemsSource="{Binding CategoryLines}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:AmountRowViewModel">
                    <Grid ColumnDefinitions="*,60,90" Margin="0,3">
                      <TextBlock Grid.Column="0" Text="{Binding Name}" LineHeight="26" />
                      <TextBlock Grid.Column="1" Text="{Binding UnitsText}" HorizontalAlignment="Right" />
                      <TextBlock Grid.Column="2" Text="{Binding TotalText}" HorizontalAlignment="Right"
                                 FontWeight="SemiBold" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <!-- Stock -->
          <Border Classes="panel cartao" IsVisible="{Binding HasStock}">
            <StackPanel>
              <TextBlock Text="Stock" Classes="section" />
              <Grid ColumnDefinitions="*,80,80,80" Margin="0,0,0,4">
                <TextBlock Grid.Column="1" Text="Vendido" FontSize="{DynamicResource TextSmall}" Foreground="{DynamicResource InkMuted}" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="2" Text="Reposto" FontSize="{DynamicResource TextSmall}" Foreground="{DynamicResource InkMuted}" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="3" Text="Em stock" FontSize="{DynamicResource TextSmall}" Foreground="{DynamicResource InkMuted}" HorizontalAlignment="Right" />
              </Grid>
              <ItemsControl ItemsSource="{Binding StockLines}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:StockRowViewModel">
                    <Grid ColumnDefinitions="*,80,80,80" Margin="0,3">
                      <TextBlock Grid.Column="0" Text="{Binding Name}" LineHeight="26" />
                      <TextBlock Grid.Column="1" Text="{Binding SoldText}" HorizontalAlignment="Right" />
                      <TextBlock Grid.Column="2" Text="{Binding AdjustedText}" HorizontalAlignment="Right" />
                      <TextBlock Grid.Column="3" Text="{Binding RemainingText}" HorizontalAlignment="Right"
                                 FontWeight="SemiBold" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,14">
            <Button Content="Exportar CSV" Command="{Binding ExportCsvCommand}" />
            <Button Content="Imprimir resumo" Command="{Binding PrintSummaryCommand}" />
            <Button Content="Cópia de segurança" Command="{Binding BackupCommand}" />
          </StackPanel>

          <!-- Taking a festival off a shared machine. Only offered for a whole
               festival, never a single night: half a festival on the computer and
               half gone is worse than either. -->
          <Border Classes="panel cartao" IsVisible="{Binding IsEventSelected}">
            <StackPanel>
              <TextBlock Text="Tirar esta festa do computador" Classes="section" />
              <TextBlock Classes="hint" TextWrapping="Wrap" Margin="0,0,0,12"
                         Text="Apaga as noites, as vendas e os talões desta festa. Os produtos, os preços e as definições ficam, para a próxima festa não começar por reescrever tudo. Não há como voltar atrás — por isso é preciso exportar primeiro." />
              <StackPanel Orientation="Horizontal" Spacing="24">
                <Button Content="Exportar e copiar" Classes="primary"
                        Command="{Binding ExportForDeleteCommand}" />
                <Button Content="{Binding DeleteEventLabel}" Classes="danger-quiet"
                        IsEnabled="{Binding CanDeleteEvent}"
                        Command="{Binding DeleteEventCommand}" />
              </StackPanel>

              <!-- Confirming is a different button in a different place, not the
                   same one tapped twice. Elsewhere in the app a double tap costs a
                   product or a print queue; here it would cost a festival, and two
                   contacts milliseconds apart at one spot is exactly what a wet
                   finger on a cold screen produces. -->
              <Border Background="#33DC2626" CornerRadius="8" Padding="14" Margin="0,16,0,0"
                      IsVisible="{Binding DeleteArmed}">
                <StackPanel Spacing="12">
                  <TextBlock Text="Isto não se desfaz. Tem os ficheiros exportados guardados noutro sítio?"
                             TextWrapping="Wrap" FontWeight="SemiBold" />
                  <StackPanel Orientation="Horizontal" Spacing="24">
                    <Button Content="Não, cancelar" Classes="quiet"
                            Command="{Binding CancelDeleteEventCommand}" />
                    <Button Content="Sim, apagar a festa" Classes="danger armed"
                            Command="{Binding ConfirmDeleteEventCommand}" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>

          <Border Height="20" Background="Transparent" />
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <Border Grid.Row="1" Padding="20,12" Background="{DynamicResource Surface1}" BorderBrush="{DynamicResource LineSoft}" BorderThickness="0,1,0,0">
      <TextBlock Text="{Binding StatusMessage}" FontSize="14" TextWrapping="Wrap" />
    </Border>
  </Grid>
</UserControl>

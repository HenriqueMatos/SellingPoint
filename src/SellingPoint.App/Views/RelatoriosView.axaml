<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SellingPoint.App.ViewModels"
             x:Class="SellingPoint.App.Views.RelatoriosView"
             x:DataType="vm:RelatoriosViewModel">

  <UserControl.Styles>
    <Style Selector="Border.cartao">
      <Setter Property="Margin" Value="0,0,0,14" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="*,Auto">
    <Grid Grid.Row="0" ColumnDefinitions="340,*" Margin="20,18,20,0">

      <!-- Session list -->
      <Border Grid.Column="0" Classes="panel cartao" Margin="0,0,12,0">
        <Grid RowDefinitions="Auto,*">
          <TextBlock Grid.Row="0" Text="Sessões" Classes="section" />
          <ListBox Grid.Row="1" ItemsSource="{Binding Sessions}"
                   SelectedItem="{Binding SelectedSession}" Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:SessionRowViewModel">
                <StackPanel Margin="0,4">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" LineHeight="26" />
                  <TextBlock Text="{Binding Detail}" FontSize="11" Opacity="0.6" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <ScrollViewer Grid.Column="1" IsVisible="{Binding HasReport}">
        <StackPanel>

          <!-- Money -->
          <Border Classes="panel cartao">
            <Grid ColumnDefinitions="*,*,*,*">
              <StackPanel Grid.Column="0">
                <TextBlock Text="Vendas" Opacity="0.6" />
                <TextBlock Text="{Binding SalesCountText}" FontSize="30" FontWeight="Bold" />
              </StackPanel>
              <StackPanel Grid.Column="1">
                <TextBlock Text="Dinheiro" Opacity="0.6" />
                <TextBlock Text="{Binding CashText}" FontSize="26" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Cartão" Opacity="0.6" />
                <TextBlock Text="{Binding CardText}" FontSize="26" />
              </StackPanel>
              <StackPanel Grid.Column="3">
                <TextBlock Text="Total" Opacity="0.6" />
                <TextBlock Text="{Binding TotalText}" FontSize="30" FontWeight="Bold" />
              </StackPanel>
            </Grid>
          </Border>

          <!-- Cash reconciliation -->
          <Border Classes="panel cartao">
            <StackPanel>
              <TextBlock Text="Caixa" Classes="section" />
              <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                <TextBlock Grid.Column="0" Text="Fundo de caixa" />
                <TextBlock Grid.Column="1" Text="{Binding FloatText}" />
              </Grid>
              <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                <TextBlock Grid.Column="0" Text="Dinheiro esperado na caixa" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1" Text="{Binding ExpectedCashText}" FontWeight="SemiBold" />
              </Grid>
              <Grid ColumnDefinitions="*,Auto" Margin="0,2" IsVisible="{Binding HasVariance}">
                <TextBlock Grid.Column="0" Text="Dinheiro contado" />
                <TextBlock Grid.Column="1" Text="{Binding CountedCashText}" />
              </Grid>
              <Grid ColumnDefinitions="*,Auto" Margin="0,2" IsVisible="{Binding HasVariance}">
                <TextBlock Grid.Column="0" Text="Diferença" FontWeight="Bold" />
                <TextBlock Grid.Column="1" Text="{Binding VarianceText}" FontWeight="Bold" />
              </Grid>

              <StackPanel IsVisible="{Binding IsSessionOpen}" Margin="0,14,0,0" Spacing="6">
                <TextBlock Text="Fechar a sessão — conte o dinheiro na caixa" Opacity="0.7" />
                <Grid ColumnDefinitions="200,Auto">
                  <TextBox Grid.Column="0" Text="{Binding CountedEntry}" PlaceholderText="0,00" Classes="numeric" FontSize="16" />
                  <Button Grid.Column="1" Content="Fechar sessão" Margin="8,0,0,0"
                          Classes="primary" Command="{Binding CloseSessionCommand}" />
                </Grid>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Per product -->
          <Border Classes="panel cartao">
            <StackPanel>
              <TextBlock Text="Por produto" Classes="section" />
              <ItemsControl ItemsSource="{Binding ProductLines}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:AmountRowViewModel">
                    <Grid ColumnDefinitions="*,60,90" Margin="0,3">
                      <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding Name}" LineHeight="26" />
                        <TextBlock Text="{Binding Detail}" FontSize="11" Opacity="0.55" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="{Binding UnitsText}" HorizontalAlignment="Right" />
                      <TextBlock Grid.Column="2" Text="{Binding TotalText}" HorizontalAlignment="Right"
                                 FontWeight="SemiBold" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <!-- Per category -->
          <Border Classes="panel cartao">
            <StackPanel>
              <TextBlock Text="Por categoria" Classes="section" />
              <ItemsControl ItemsSource="{Binding CategoryLines}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:AmountRowViewModel">
                    <Grid ColumnDefinitions="*,60,90" Margin="0,3">
                      <TextBlock Grid.Column="0" Text="{Binding Name}" LineHeight="26" />
                      <TextBlock Grid.Column="1" Text="{Binding UnitsText}" HorizontalAlignment="Right" />
                      <TextBlock Grid.Column="2" Text="{Binding TotalText}" HorizontalAlignment="Right"
                                 FontWeight="SemiBold" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <!-- Stock -->
          <Border Classes="panel cartao" IsVisible="{Binding HasStock}">
            <StackPanel>
              <TextBlock Text="Stock" Classes="section" />
              <Grid ColumnDefinitions="*,80,80,80" Margin="0,0,0,4">
                <TextBlock Grid.Column="1" Text="Vendido" FontSize="11" Opacity="0.6" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="2" Text="Reposto" FontSize="11" Opacity="0.6" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="3" Text="Em stock" FontSize="11" Opacity="0.6" HorizontalAlignment="Right" />
              </Grid>
              <ItemsControl ItemsSource="{Binding StockLines}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:StockRowViewModel">
                    <Grid ColumnDefinitions="*,80,80,80" Margin="0,3">
                      <TextBlock Grid.Column="0" Text="{Binding Name}" LineHeight="26" />
                      <TextBlock Grid.Column="1" Text="{Binding SoldText}" HorizontalAlignment="Right" />
                      <TextBlock Grid.Column="2" Text="{Binding AdjustedText}" HorizontalAlignment="Right" />
                      <TextBlock Grid.Column="3" Text="{Binding RemainingText}" HorizontalAlignment="Right"
                                 FontWeight="SemiBold" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,20">
            <Button Content="Exportar CSV" Command="{Binding ExportCsvCommand}" />
            <Button Content="Imprimir resumo" Command="{Binding PrintSummaryCommand}" />
            <Button Content="Cópia de segurança" Command="{Binding BackupCommand}" />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <Border Grid.Row="1" Padding="20,12" Background="{DynamicResource Surface1}" BorderBrush="{DynamicResource LineSoft}" BorderThickness="0,1,0,0">
      <TextBlock Text="{Binding StatusMessage}" FontSize="14" TextWrapping="Wrap" />
    </Border>
  </Grid>
</UserControl>
